<!DOCTYPE html>
<html lang="mn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scent of M | Italian Boutique</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; background: #FAF9F6; transition: all 0.5s ease; }
        .serif { font-family: 'Cormorant Garamond', serif; }
        .hover-lift { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        .hover-lift:hover { transform: translateY(-10px); }
    </style>
</head>
<body>

    <nav class="fixed w-full z-50 p-6 flex justify-between items-center bg-white/80 backdrop-blur-md">
        <h1 class="text-3xl font-bold serif tracking-widest">SCENT OF M</h1>
        <div class="flex gap-6 items-center">
            <button onclick="toggleAdmin()" class="text-[9px] uppercase tracking-widest opacity-40">Admin</button>
            <button onclick="toggleCart()" class="text-xl">🛒 <span id="cartCount">0</span></button>
        </div>
    </nav>

    <main class="pt-32 px-6 container mx-auto">
        <div id="adminPanel" class="hidden bg-white p-8 border border-gray-200 mb-10">
            <h2 class="text-2xl serif mb-4">Inventory Control</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <input id="pName" placeholder="Name" class="border p-2">
                <input id="pPrice" placeholder="Price" type="number" class="border p-2">
                <select id="pCat" class="border p-2"><option>Coffee</option><option>Cake</option><option>Gelato</option><option>Meal</option></select>
                <button onclick="addProduct()" class="bg-black text-white py-2">Add Item</button>
            </div>
        </div>

        <div id="productGrid" class="grid grid-cols-1 md:grid-cols-4 gap-8"></div>
    </main>

    <div id="cartSidebar" class="fixed right-0 top-0 h-full w-96 bg-white shadow-2xl p-8 transform translate-x-full transition-transform z-50">
        <h2 class="text-2xl serif mb-6">Your Selection</h2>
        <div id="cartItems" class="space-y-4"></div>
        <button onclick="checkout()" class="w-full mt-10 bg-black text-white py-4">Checkout</button>
    </div>

    <script>
        let products = JSON.parse(localStorage.getItem('products')) || [{id:1, name:'Espresso', price:5, cat:'Coffee'}];
        let cart = [];

        function render() {
            document.getElementById('productGrid').innerHTML = products.map(p => `
                <div class="border p-4 hover-lift bg-white shadow-sm">
                    <div class="h-40 bg-gray-100 mb-4 flex items-center justify-center text-gray-400">Image</div>
                    <h3 class="text-lg serif">${p.name}</h3>
                    <p class="text-[#C9A96A]">$${p.price}</p>
                    <button onclick="addToCart(${p.id})" class="mt-4 w-full border border-black py-2">Add</button>
                </div>
            `).join('');
        }

        function addProduct() {
            products.push({id:Date.now(), name:document.getElementById('pName').value, price:Number(document.getElementById('pPrice').value), cat:document.getElementById('pCat').value});
            localStorage.setItem('products', JSON.stringify(products));
            render();
        }

        function addToCart(id) { cart.push(products.find(p => p.id === id)); document.getElementById('cartCount').innerText = cart.length; }
        function toggleAdmin() { if(prompt("Pass:") === 'moeed1490') document.getElementById('adminPanel').classList.toggle('hidden'); }
        function toggleCart() { document.getElementById('cartSidebar').classList.toggle('translate-x-full'); }
        function checkout() { alert("Order placed!"); cart=[]; document.getElementById('cartCount').innerText=0; toggleCart(); }

        render();
    </script>
</body>
</html>
